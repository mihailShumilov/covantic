# Covantic — Environment Variables
# Copy to .env and fill in values

# -- Solana --
SOLANA_NETWORK=devnet
# The primary endpoint. Every transaction this service SENDS goes here and
# only here — failing a send over to a second endpoint risks it landing twice.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Read-only fallbacks, comma-separated, in preference order.
#
# Reads (balances, signatures, transactions, account data) fail over across
# SOLANA_RPC_URL plus these. Leaving it empty is the old behaviour: one
# endpoint, and when that provider hits its quota the balance checkpoints stop
# with it — which is what turns valid exploit and agent-error claims into
# failed ones. Set at least one.
#
# An endpoint that fails three times in a row is dropped from rotation for
# 30 s, or 5 min if it answered 429, and skipped without a network call until
# then. Watch it at GET /api/health/rpc.
# Must be https, and must serve the same cluster as SOLANA_NETWORK — that is
# checked once at boot and a mismatched fallback is ejected permanently.
# Replace with your own second endpoint for this cluster.
SOLANA_RPC_FALLBACK_URLS=YOUR_SECOND_RPC_URL_FOR_THIS_CLUSTER

# Rank endpoints by slot freshness before each read. Off by default: it is
# implemented as a getSlot probe against EVERY endpoint before EVERY request,
# so it multiplies request volume by the endpoint count. Turn it on only where
# the extra traffic is affordable.
SOLANA_RPC_FRESHNESS_AWARE=false

# Program ID (after anchor deploy)
PROGRAM_ID=YOUR_PROGRAM_ID_AFTER_DEPLOY

# Where the fleet runner sends its demo transfers. Set this so the fleet
# container does not need ORACLE_KEYPAIR_PATH at all — it only ever needed a
# public key, and that key is also the config admin and the mint authority.
FLEET_SINK_ADDRESS=

# Signs as the mint authority of the covered (mock) mint. Keep this OFF the
# oracle key: the oracle is hot — it lives in three containers, including the
# fleet runner — while whoever holds the mint authority can mint the covered
# asset outright. Unset, it falls back to ORACLE_KEYPAIR_PATH, which is the
# un-split arrangement.
MINT_AUTHORITY_KEYPAIR_PATH=

# Oracle keypair (JSON secret key file)
# Generate: solana-keygen new -o keys/oracle-keypair.json
ORACLE_KEYPAIR_PATH=./keys/oracle-keypair.json

# -- Helius --
# Get at: https://dev.helius.xyz/
HELIUS_API_KEY=YOUR_HELIUS_API_KEY

# Pyth Hermes. The public host (hermes.pyth.network) now answers 401 to
# anonymous requests, so leave these unset only if you accept Pyth dropping
# out of the price consensus — claims still resolve against the exchange
# references, one source short, and the bundle records why.
PYTH_HERMES_URL=
PYTH_HERMES_API_KEY=

# Archival RPC for `pnpm backtest:fetch`. Optional: the default public
# endpoint serves long-term storage, just with a tight rate limit.
SOLANA_ARCHIVE_RPC_URL=

# How often the exploit and oracle watchers sweep, in milliseconds. Default
# 120000. Lower it on devnet so a staged incident shows up in seconds rather
# than minutes; each exploit sweep writes an on-chain checkpoint, so a very
# short interval spends the oracle wallet's SOL faster.
# Validated at boot: 5000 ms floor, and a ceiling of a quarter of
# MAX_CHECKPOINT_AGE (2 h). The ceiling is the load-bearing half — a cadence
# wider than that window does not slow detection, it makes every provable
# claim unprovable, and a payout that reverts is recorded `failed`, not
# `review`. Leave commented out to take the 120000 default; an assigned-empty
# value is now rejected rather than silently becoming 0.
# EXPLOIT_SWEEP_INTERVAL_MS=120000
# ORACLE_SWEEP_INTERVAL_MS=120000


# Number of reverse proxies in front of this service, or `false` when there is
# none. `true` would make X-Forwarded-For — a header the client writes — the
# value every rate limit keys on.
TRUST_PROXY=1

# Must be at least 64 chars (generate via: openssl rand -hex 32)
HELIUS_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_64_OR_MORE_CHARS_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Bearer token for real Helius deliveries, kept separate from the HMAC key
# above: Helius echoes this header on every request, so anything that logs
# headers sees it. Falls back to HELIUS_WEBHOOK_SECRET when unset.
HELIUS_WEBHOOK_BEARER=

# HMAC secret for the internal `monitoring:alerts` Redis bus. Any process
# that publishes alerts must share this secret; generate via:
#   openssl rand -hex 32
ALERT_HMAC_SECRET=CHANGE_ME_MIN_32_CHARS_XXXXXXXXXXXXX

# Publicly reachable URL where Helius can deliver webhooks. Used by
# `pnpm webhook:sync` to register the receiver with Helius.
# Local dev: expose port 4099 with ngrok, set to the ngrok https URL.
#   ngrok http 4099
#   WEBHOOK_PUBLIC_URL=https://XXXX-YYY-ZZZ.ngrok-free.app
# Prod: use the real hostname (e.g. https://api.covantic.org)
# Optional — leave unset to skip webhook registration.
WEBHOOK_PUBLIC_URL=

# -- Database --
# Set POSTGRES_PASSWORD first (docker-compose consumes it); this URL uses it.
POSTGRES_USER=covantic
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=covantic
DATABASE_URL=postgresql://covantic:${POSTGRES_PASSWORD}@localhost:5499/covantic

# -- Redis --
# Password used by docker-compose and embedded in REDIS_URL.
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6399

# -- API Server --
PORT=4099
LOG_LEVEL=debug

# -- Frontend --
NEXT_PUBLIC_API_URL=http://localhost:4099
NEXT_PUBLIC_WS_URL=ws://localhost:4099
# WARNING: NEXT_PUBLIC_* is inlined into the browser bundle and is readable by
# every visitor, and recoverable from the image via `docker history`. Never put
# a keyed provider URL here — use a public endpoint, or a proxy you control.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=YOUR_PROGRAM_ID_AFTER_DEPLOY
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# -- USDC Mint (devnet) --
# Devnet USDC: test SPL token mint
# Created by setup-local.sh
# Covered mint for this cluster. Required for agent-error claims to open.
# Leave blank rather than filling a placeholder — a short value now fails validation.
USDC_MINT=

# Settle oracle-manipulation payouts through verify_and_payout_v2, which makes
# the program verify a guardian-signed Pyth price instead of trusting the
# oracle's word for the amount. Requires a program build that includes the
# instruction — leave false until the redeploy, or every payout will fail.
# Claims that cannot be proven go to review; they never fall back to the
# unverified path.
ORACLE_PROOF_ENABLED=false

# Settle exploit payouts through verify_and_payout_exploit, which makes the
# program measure the balance drop itself — re-reading the covered account and
# refusing to pay more than the difference from its own earlier checkpoint —
# instead of trusting the oracle's amount. Requires a program build that
# includes the instruction and a running checkpoint crank; leave false until
# the redeploy, or every exploit payout will fail. Claims that cannot be
# proven go to review; they never fall back to the unverified path.
EXPLOIT_PROOF_ENABLED=false

# Settle governance payouts through verify_and_payout_governance, which makes
# the program compare the holder's own matured declaration of who may control
# the agent against what it reads on the covered account now. Requires a
# program build that includes the instruction and a running authority-
# checkpoint crank; leave false until the redeploy.
#
# One extra condition, specific to this path: the holder must have declared a
# baseline (`pnpm gov:declare`) and it must have matured — an hour by default.
# A policy with no declaration resolves to review whether this flag is on or
# off, so turning it on changes nothing for existing policies until they
# declare. That is the intended migration, not a bug.
GOVERNANCE_PROOF_ENABLED=false

# Settle agent-error payouts through verify_and_payout_agent_error, which makes
# the program measure the balance drop itself and refuse to pay more than the
# amount by which it exceeded an operating envelope the holder declared.
# Requires a program build that includes the instruction; leave false until the
# redeploy.
#
# Two extra conditions, and they fail differently — which is why this flag is
# the one to be careful with:
#   - The holder must have declared a mandate (`pnpm mandate:declare`) and it
#     must have matured. A policy with no mandate resolves to review before any
#     RPC call, so turning the flag on changes nothing for it. Harmless.
#   - A fresh balance checkpoint must exist, written by the exploit-watcher
#     crank. Without one the on-chain call REVERTS and the keeper marks the
#     claim `failed`, not `review` — a valid claim becomes a dead one.
# So: do not enable this unless the workers are confirmed running.
AGENT_ERROR_PROOF_ENABLED=false

# Cap on automatic payouts in a rolling hour, in USDC lamports (6 decimals).
# 100000000000 = 100,000 USDC. Set to 0 to disable.
# The backstop that survives a per-claim bound being wrong: the failure that
# destroys a vault is the same bad payout repeated, not one of them. Claims
# over the cap queue to review rather than being rejected.
AUTO_PAYOUT_HOURLY_LIMIT_RAW=100000000000
