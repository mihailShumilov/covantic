{
  // Typecheck-only view of the package.
  //
  // `tsconfig.json` is the *build* config: it sets `rootDir: ./src` so the
  // emitted layout is correct, which means `tests/` and `scripts/` are outside
  // its `include` and were never typechecked at all. vitest strips types with
  // esbuild without checking them, so ~9.5k lines of test code had no
  // strict-mode verification. This config checks everything and emits nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"],
  // `scripts/` is in now. It was held out on the grounds that its looseness
  // predated this config, and that debt turned out to include a `memcmp`
  // filter encoded base64 where the RPC reads base58 — so the staker-position
  // migration matched nothing and reported having nothing to migrate — a call
  // to a function that had been deleted, and a claim field read off a type
  // that never declared it, which made the comparison always false.
  //
  // `tests/e2e.test.ts` stays out: it is network-gated and not run here.
  "exclude": ["tests/e2e.test.ts", "dist"]
}
