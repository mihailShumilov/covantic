{
  "name": "@covantic/near-oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike": "tsx --env-file=.env spike/run.ts",
    "typecheck": "tsc --noEmit",
    "near:deploy": "tsx --env-file=.env scripts/near-deploy.ts",
    "agent": "tsx --env-file=.env agent/src/index.ts",
    "contract:build": "bash scripts/build-contract.sh",
    "near:top-up": "tsx --env-file=.env scripts/near-top-up.ts",
    "demo:guardrail": "tsx --env-file=.env scripts/demo-guardrail.ts",
    "demo:attack": "pnpm demo:guardrail",
    "pretest": "pnpm --filter @covantic/shared build",
    "test": "pnpm test:contract && pnpm test:agent",
    "test:contract": "cd contracts/trigger && cargo test",
    "test:agent": "vitest run"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@covantic/shared": "workspace:^",
    "@neardefi/shade-agent-js": "2.2.0",
    "@pythnetwork/pyth-solana-receiver": "^0.16.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.98.0",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
